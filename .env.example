# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this to .env on your EC2 instance and fill in values.
#
# NEVER commit a real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<your-supabase-secret-key>
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Redis ─────────────────────────────────────────────────────────────────────
# Shared Redis container on appnet. /1 = database 1 (isolated from DB 0)
REDIS_URL=redis://redis:6379/1

# ── URLs ─────────────────────────────────────────────────────────────────────
# Replace with your micro URL domain
BASE_URL=https://micro.sumoraai.in
FRONTEND_URL=https://microurl-three.vercel.app
